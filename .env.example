# ==============================================================================
# AP Government Finance Intelligence Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your credentials:
# cp .env.example .env

# --- Project Metadata ---
PROJECT_NAME="AP Government Finance Intelligence"

# --- Supabase PostgreSQL Database ---
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:your_supabase_password@db.your_project.supabase.co:5432/postgres"
SUPABASE_URL="https://your_project.supabase.co"
SUPABASE_KEY="your_supabase_anon_or_service_key"

# --- Weaviate Cloud (Vector & Full-Text Search) ---
# Weaviate Cloud Serverless Cluster URL and API Key
WEAVIATE_URL="https://your-cluster-url.weaviate.cloud"
WEAVIATE_API_KEY="your_weaviate_api_key"
WEAVIATE_INDEX_NAME="GovIntelDocument"

# --- Embedding Model ---
# 768-dimensional dense embeddings for policy and budget text
EMBEDDING_MODEL_NAME="BAAI/bge-base-en-v1.5"
EMBEDDING_DIMENSION=768

# --- Google Gemini AI ---
# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key"
GOOGLE_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"
LLM_PROVIDER="gemini"

# --- Optional Web API & Server Settings ---
API_BASE_URL="http://localhost:8000"
PORT=8000
HOST="0.0.0.0"
